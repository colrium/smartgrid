    "whyAerialSurveyDronesMatter": {
      "description": "Our drone solutions deliver critical insights across multiple sectors, transforming how projects are planned, managed, and monitored.",
      "headline": "Why Aerial Survey Drones Matter?",
      "items": [{
  "description": "We use LiDAR-equipped drones to generate precise 3D, topographic, and land use maps—capturing insights at a scale and clarity beyond traditional methods. This high-resolution data enhances planning, design, and decision-making across large project areas.",
  "icon": "map",
  "title": "Detailed Mapping"
}, {
  "description": "Our drone-based surveys monitor environmental changes like vegetation loss, water shifts, and land degradation—providing critical insights for sustainability and compliance. This aerial perspective supports climate tracking, impact assessments, and proactive resource management.",
  "icon": "tree-outline",
  "title": "Environmental Monitoring"
}, {
  "description": "Our aerial drone surveys support efficient resource management by monitoring forests, water bodies, and land use patterns. This data-driven approach helps identify areas needing conservation or optimized utilization.",
  "icon": "earth",
  "title": "Resource Management"
}, {
  "description": "We use drone-based multispectral imaging to monitor crop health, soil variability, and irrigation efficiency. This empowers farmers with actionable data for precision agriculture, leading to optimized yields and reduced input costs.",
  "icon": "leaf",
  "title": "Precision Agriculture"
}, {
  "description": "Our aerial surveys deliver a high-level view of terrain, infrastructure, and environment—essential for accurate site selection and feasibility analysis. This data streamlines planning for urban development, transport networks, and effective land use.",
  "icon": "city",
  "title": "Construction Planning"
}, {
  "description": "We use drone surveys to conduct precise Environmental Impact Assessments—capturing data on land cover, habitats, and ecological changes in real time. This allows for smarter project planning with minimal disruption to natural environments.",
  "icon": "clipboard-check",
  "title": "Environmental Impact Assessment"
}, {
  "description": "Our drones capture high-resolution imagery and LiDAR data to assess the condition of construction sites, assets, power lines, substations, roadways, and utility corridors. This enables detailed infrastructure audits, early detection of wear or damage, and data-driven asset management planning.",
  "icon": "cog",
  "title": "Infrastructure Management"
}, {
  "description": "SmartGrid Surveying deploys drones rapidly after disasters to capture real-time imagery and 3D maps of affected areas. This enables emergency teams to assess damage, plan safe access routes, and prioritize relief efforts with precision.",
  "icon": "map-clock",
  "title": "Disaster Mapping"
}],
      "tag": "Key Applications",
      "type": "card-grid"
    }
