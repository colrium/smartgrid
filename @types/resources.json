      "items": [{
  "description": "Heavy clay attenuates the radar signal and reduces effective penetration depth.",
  "icon": "earth",
  "title": "Clay Soils"
}, {
  "description": "Concentrated rebar and mesh cause signal scattering and clutter inside concrete.",
  "icon": "grid-large",
  "title": "Dense Reinforcement"
}, {
  "description": "High soil moisture changes the dielectric response and can mask target signatures.",
  "icon": "water-outline",
  "title": "Wet Ground"
}, {
  "description": "Typical detection depth varies between 0.5m – 4m depending on soil and antenna configuration.",
