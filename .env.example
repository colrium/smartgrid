# Sanity CMS configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SANITY_USE_CDN=true

# Optional token for write operations or preview mode
SANITY_API_TOKEN=your_sanity_api_token

# Formspree contact form
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id

#Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_measurement_id

# Optional free live chat via Tawk.to
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_tawk_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Floating WhatsApp contact button, digits only or international format
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000001
