# Base — must match the deployed production domain: the generated sitemap,
# robots.txt and all canonical/hreflang URLs are derived from it.
# (Preview deployments override this with their own domain env var.)
NEXT_PUBLIC_SITE_URL=https://smartgridsurveying.com

# Formspree contact form
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id

#Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_measurement_id

# Optional free live chat via Tawk.to
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_tawk_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Floating WhatsApp contact button fallback, digits only or international
# format. The Keystatic `Site layout` singleton's chat group overrides this
# at runtime when published and configured (see M9 note below); this env
# value is the fallback for deploys without a configured chat group.
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000001

#Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_actual_api_key_here

# Display-only media protection: HMAC secret used to sign short-lived /media/* URLs.
# Server-side only (never NEXT_PUBLIC_*). Required in production — generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_SIGNING_KEY=replace_with_a_long_random_secret

# Signed media URL lifetime in seconds (30–604800; default 900 = 15 minutes).
# Links are minted at page render and consumed by the visitor within seconds, so
# a short TTL makes them effectively die shortly after the image is served.
# Fresh page loads always receive fresh signatures — raise this only if
# below-the-fold lazy images break during very long reading sessions.
MEDIA_TTL_SECONDS=900


# CMS
# Admin access for the Keystatic console (/keystatic/* + /api/keystatic/*).
# - Local development (NODE_ENV=development) skips admin auth so editors can
#   work credential-free against local-filesystem storage.
# - Every non-development environment requires both values below; when either
#   is missing the src/proxy.ts edge gate rejects ALL admin requests (401).
# Generate with `yarn mediakeygen` and rotate regularly. Never commit values.
KEYSTATIC_ADMIN_USER=owner
KEYSTATIC_ADMIN_PASSWORD=<generate-with-yarn-mediakeygen-and-rotate-regularly>

# Keystatic storage: local filesystem by default (no credentials needed).
# For GitHub-backed editing on a deployed environment only, set all five:
#   KEYSTATIC_GITHUB_REPO=owner/name
#   NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=<github-app-slug>
#   KEYSTATIC_GITHUB_CLIENT_ID=<client id from the Keystatic GitHub App>
#   KEYSTATIC_GITHUB_CLIENT_SECRET=<client secret from the app settings>
#   KEYSTATIC_SECRET=<random >=32 chars, signs the editor session>
# (Install the Keystatic GitHub App on the repo first — the slug is the
# app's URL slug; edits commit straight to the deployment branch by
# default. Leaving KEYSTATIC_GITHUB_REPO unset keeps local dev on
# filesystem storage, credential-free.)
# Step-by-step guide: README.md → "Keystatic Page Builder (operator guide)"
# → "GitHub-backed editing (deployed CMS, step by step)".

# Page-builder source switch (M3/M7; semantics amended 2026-09-21): an
# empty/unset value serves every PUBLISHED entry from Keystatic (draft
# entries never serve — legacy stays live until a page is published). Set a
# comma-separated list to RESTRICT serving to those slugs only. 30 pages are
# migrated (all `draft` until each page's publish; see
# docs/keystatic-page-builder/plan.md for the full list).
# Example (restrict to a few entries while testing):
# KEYSTATIC_PAGES=terms-of-use,privacy-policy,about,home
# Site layout (M9): the reserved slug `site` controls the singleton too —
# with the default (empty) it serves the published navbar, footer, contacts,
# socials, cookie consent AND the WhatsApp chat button from the `site`
# singleton (`content/site.json`) site-wide, both locales. With a list,
# add `site` to it:
# KEYSTATIC_PAGES=terms-of-use,site
# Emergency rollback: set to "1" to force legacy rendering on all routes
# (pages and layout alike).
# KEYSTATIC_DISABLE=