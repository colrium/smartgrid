# Base — must match the deployed production domain: the generated sitemap,
# robots.txt and all canonical/hreflang URLs are derived from it.
# (Preview deployments override this with their own domain env var.)
NEXT_PUBLIC_SITE_URL=https://smartgridsurveying.com

# Formspree contact form
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id

#Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_measurement_id

# Optional free live chat via Tawk.to
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_tawk_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Floating WhatsApp contact button, digits only or international format
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000001

#Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_actual_api_key_here

# Display-only media protection: HMAC secret used to sign short-lived /media/* URLs.
# Server-side only (never NEXT_PUBLIC_*). Required in production — generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_SIGNING_KEY=replace_with_a_long_random_secret

# Signed media URL lifetime in seconds (30–604800; default 900 = 15 minutes).
# Links are minted at page render and consumed by the visitor within seconds, so
# a short TTL makes them effectively die shortly after the image is served.
# Fresh page loads always receive fresh signatures — raise this only if
# below-the-fold lazy images break during very long reading sessions.
MEDIA_TTL_SECONDS=900


# CMS
KEYSTATIC_ADMIN_USER=owner
KEYSTATIC_ADMIN_PASSWORD=<strong-random-value>

# Keystatic storage: local filesystem by default (no credentials needed).
# For GitHub-backed editing on a deployed environment only, set:
# KEYSTATIC_GITHUB_REPO=owner/name
# GitHub App authentication for deployed editing is an M5 setup step:
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Page-builder source switch (M3): comma-separated page slugs served from
# Keystatic instead of locale JSON. Empty/unset (default) renders every
# route from legacy locale JSON. Migration happens page by page (M4).
# KEYSTATIC_PAGES=terms-of-use
# Emergency rollback: set to "1" to force legacy rendering on all routes.
# KEYSTATIC_DISABLE=