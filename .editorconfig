root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,jsx}]
indent_style = tab
indent_size = 4

[*.{json,yaml,yml}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4

[*.{html,svg}]
indent_style = tab
indent_size = 4
prettier_bracket_same_line = false
prettier_html_whitespace_sensitivity = strict