{
	"name": "smartgrid-surveying-and-engineering",
	"version": "1.0.0",
	"main": "index.js",
	"license": "MIT",
	"browserslist": [
		"chrome >= 100",
		"edge >= 100",
		"firefox >= 100",
		"safari >= 15"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"dev": "next dev --webpack",
		"build": "next build  --webpack",
		"postbuild": "next-sitemap",
		"start": "next start -p 3000",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"typecheck": "tsc --project ./tsconfig.json --noEmit",
		"clean": "rimraf .next",
		"import-locales": "tsx scripts/import-locales.ts",
		"sync-locales": "tsx scripts/sync-locales.ts",
		"nuke:install": "rimraf ./node_modules ./package-lock.json",
		"toc": "i18next-cli types",
		"merge": "i18next-cli types",
		"interface": "i18next-cli types",
		"typegen": "sanity schema extract && sanity typegen generate"
	},
	"dependencies": {
		"@formspree/react": "^3.0.0",
		"@mdi/font": "^7.4.47",
