		"gsap": "^3.15.0",
		"hamo": "^1.0.3",
		"i18next": "^26.0.1",
		"lenis": "^1.3.23",
		"next": "^16.2.1",
		"next-i18next": "^16.0.6",
		"next-language-detector": "^1.1.1",
		"next-sanity": "^13.3.3",
		"next-sitemap": "^4.2.3",
		"ogl": "^1.0.11",
		"postcss": "^8.5.14",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-globe.gl": "^2.38.0",
		"react-i18next": "^17.0.1",
		"sanity": "^6.12.0",
